            "city": "Orlando, FL",
            "stars": 5
          }
        },
        "testimonial_jXmchN": {
          "type": "testimonial",
          "settings": {
            "quote": "I've played in a lot of adult rec leagues over the years, and Silly Pickles is my favorite by a longgggg shot. I'm a lifer!",
