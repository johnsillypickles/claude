        "testimonial_6GxrEa": {
          "type": "testimonial",
          "settings": {
            "quote": "Silly Pickles is a fun way to play pickleball. The league matches players of similar skill levels, making games enjoyable and welcoming. The socials are also fun after the games. Highly recommend!",
